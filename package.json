{
  "name": "regrip",
  "private": true,
  "version": "1.0.0",
  "author": {
    "name": "Werner Stein",
    "email": "werner.stein@gmail.com",
    "url": "https://github.com/wstein"
  },
  "type": "module",
  "scripts": {
    "res:build": "rescript",
    "res:watch": "rescript watch",
    "res:clean": "rescript clean",
    "prepare": "husky",
    "dev": "run-p res:watch dev:vite",
    "dev:vite": "vite",
    "docs:api": "typedoc --options typedoc.json",
    "docs:check": "typedoc --options typedoc.json --emit none --treatValidationWarningsAsErrors",
    "check:events": "node scripts/check-smartcube-events.mjs",
    "check:declarations": "node scripts/check-rescript-declarations.mjs",
    "format": "rescript format && prettier --write .",
    "format:check": "rescript format --check && prettier --check .",
    "build": "rescript && tsc && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "rescript && vitest run",
    "test:browser": "playwright test",
    "test:screenshots": "playwright test test/browser/ui-screenshots.spec.ts",
    "test:screenshots:update": "playwright test test/browser/ui-screenshots.spec.ts --update-snapshots",
    "test:snapshot": "rescript && vitest run src/session/jsonlMock.e2e.test.ts --update",
    "test:watch": "run-p res:watch test:vitest",
    "test:vitest": "vitest"
  },
  "lint-staged": {
    "*.{res,resi}": "rescript format",
    "src/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{js,mjs,cjs,css,html,json,md,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "^1.63.0",
    "@types/aes-js": "^3.1.4",
    "@types/node": "^26.4.1",
    "@types/three": "^0.165.0",
    "@vitejs/devtools": "0.5.2",
    "ajv": "^8.20.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "rescript": "^12.3.1",
    "rescript-vitest": "^3.0.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "~4.1.11"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4",
    "@types/web-bluetooth": "^0.0.21",
    "cubing": "^0.63.4",
    "rxjs": "^7.8.2",
    "smartcube-web-bluetooth": "github:wstein/smartcube-web-bluetooth#559399122d7b590f5d4d38e9700e73de13e712ab",
    "three": "^0.185.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
