  },
  "type": "module",
  "scripts": {
    "res:build": "rescript",
    "res:watch": "rescript watch",
    "res:clean": "rescript clean",
    "dev": "run-s res:build && run-p res:watch dev:vite",
    "dev:vite": "vite",
    "docs:api": "typedoc --options typedoc.json",
    "format": "rescript format && prettier --write .",
    "format:check": "rescript format --check && prettier --check .",
    "build": "rescript && tsc && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "test": "rescript && vitest run",
    "test:watch": "run-p res:watch test:vitest",
    "test:vitest": "vitest"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/node": "^22.20.1",
    "@types/three": "^0.165.0",
    "@vitejs/devtools": "0.5.2",
    "ajv": "^8.20.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "rescript": "^12.3.1",
    "rescript-vitest": "^3.0.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "~4.1.11"
  },
  "dependencies": {
    "@types/web-bluetooth": "^0.0.20",
    "cubing": "^0.51.2",
    "rxjs": "^7.8.2",
    "smartcube-web-bluetooth": "github:wstein/smartcube-web-bluetooth#559399122d7b590f5d4d38e9700e73de13e712ab",
    "three": "^0.165.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
