    "npm-run-all2": "^9.0.3",
    "rescript": "^12.3.1",
    "rescript-vitest": "^3.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@types/web-bluetooth": "^0.0.20",
    "cubing": "^0.51.2",
    "rxjs": "^7.8.2",
    "smartcube-web-bluetooth": "github:wstein/smartcube-web-bluetooth#559399122d7b590f5d4d38e9700e73de13e712ab",
