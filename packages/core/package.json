{
  "name": "@wstein/regrip-core",
  "version": "0.1.0",
  "description": "MIT smart-cube session core for Regrip and CubeLab",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "rescript && tsc --project tsconfig.build.json",
    "prepack": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bindings/*.res.mjs": "./src/bindings/*.res.mjs",
    "./bindings/Bindings_SmartCube": {
      "types": "./dist/bindings/Bindings_SmartCube.gen.d.ts",
      "default": "./dist/bindings/Bindings_SmartCube.gen.js"
    },
    "./bindings/*": {
      "types": "./dist/bindings/*.d.ts",
      "default": "./dist/bindings/*.js"
    },
    "./domain/*.res.mjs": "./src/domain/*.res.mjs",
    "./domain/Time": {
      "types": "./dist/domain/Time.gen.d.ts",
      "default": "./dist/domain/Time.gen.js"
    },
    "./domain/MoveBuffer": {
      "types": "./dist/domain/MoveBuffer.gen.d.ts",
      "default": "./dist/domain/MoveBuffer.gen.js"
    },
    "./domain/ReplayCursor": {
      "types": "./dist/domain/ReplayCursor.gen.d.ts",
      "default": "./dist/domain/ReplayCursor.gen.js"
    },
    "./domain/MoveTracker": {
      "types": "./dist/domain/MoveTracker.gen.d.ts",
      "default": "./dist/domain/MoveTracker.gen.js"
    },
    "./domain/SnapshotDeduper": {
      "types": "./dist/domain/SnapshotDeduper.gen.d.ts",
      "default": "./dist/domain/SnapshotDeduper.gen.js"
    },
    "./domain/MoveBackTrigger": {
      "types": "./dist/domain/MoveBackTrigger.gen.d.ts",
      "default": "./dist/domain/MoveBackTrigger.gen.js"
    },
    "./domain/CubeFacelets": {
      "types": "./dist/domain/CubeFacelets.gen.d.ts",
      "default": "./dist/domain/CubeFacelets.gen.js"
    },
    "./domain/Timer": {
      "types": "./dist/domain/Timer.gen.d.ts",
      "default": "./dist/domain/Timer.gen.js"
    },
    "./domain/PlayerSync": {
      "types": "./dist/domain/PlayerSync.gen.d.ts",
      "default": "./dist/domain/PlayerSync.gen.js"
    },
    "./domain/Quaternion": {
      "types": "./dist/domain/Quaternion.gen.d.ts",
      "default": "./dist/domain/Quaternion.gen.js"
    },
    "./domain/CubeNotation": {
      "types": "./dist/domain/CubeNotation.gen.d.ts",
      "default": "./dist/domain/CubeNotation.gen.js"
    },
    "./domain/SensorToBody": {
      "types": "./dist/domain/SensorToBody.gen.d.ts",
      "default": "./dist/domain/SensorToBody.gen.js"
    },
    "./domain/GyroOrientation": {
      "types": "./dist/domain/GyroOrientation.gen.d.ts",
      "default": "./dist/domain/GyroOrientation.gen.js"
    },
    "./session/replay/fixtures/*.jsonl": "./src/session/replay/fixtures/*.jsonl",
    "./session/*": {
      "types": "./dist/session/*.d.ts",
      "default": "./dist/session/*.js"
    }
  },
  "files": [
    "dist",
    "src/bindings/*.res.mjs",
    "src/bindings/*.res.d.mts",
    "src/domain/*.res.mjs",
    "src/domain/*.res.d.mts",
    "src/session/replay/fixtures/*.jsonl",
    "!src/**/*_test.res.mjs"
  ],
  "peerDependencies": {
    "rxjs": "^7.8.2",
    "smartcube-web-bluetooth": "^4.0.0"
  },
  "dependencies": {
    "@rescript/runtime": "^12.3.1"
  },
  "devDependencies": {
    "gentype": "^4.5.0",
    "rescript": "^12.3.1",
    "typescript": "^5.9.3"
  }
}
