{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@wstein/regrip-core/*": ["src/*"],
      "smartcube-web-bluetooth": ["../../node_modules/smartcube-web-bluetooth/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.mts"]
}
