{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Regrip API",
  "sourceLinkTemplate": "https://github.com/wstein/regrip/blob/{gitRevision}/{path}#L{line}",
  "entryPointStrategy": "expand",
  "entryPoints": ["packages/core/src/**/*.res.d.mts"],
  "out": "docs/api",
  "readme": "none",
  "excludeInternal": true,
  "excludePrivate": true,
  "customCss": "./docs/api-theme.css",
  "titleLink": "/regrip/",
  "navigationLinks": {
    "Lab": "/regrip/",
    "Docs": "/regrip/docs.html",
    "GitHub": "https://github.com/wstein/regrip"
  }
}
