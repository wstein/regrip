{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Regrip API",
  "sourceLinkTemplate": "https://github.com/wstein/regrip/blob/{gitRevision}/{path}#L{line}",
  "entryPointStrategy": "expand",
  "entryPoints": ["packages/core/src/**/*.res.d.mts"],
  "out": "docs/site/api",
  "plugin": ["typedoc-plugin-markdown", "typedoc-vitepress-theme"],
  "docsRoot": "docs/site",
  "entryFileName": "index.md",
  "sidebar": {
    "collapsed": true,
    "pretty": true
  },
  "readme": "none",
  "excludeInternal": true,
  "excludePrivate": true
}
