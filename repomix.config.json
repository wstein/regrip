{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "input": {
    "maxFileSize": 1048576
  },
  "output": {
    "filePath": "repomix-smartcube-example.txt",
    "style": "xml",
    "filePathStyle": "target-relative",
    "parsableStyle": false,
    "headerText": "# Smartcube Example — curated handover\n\nThis bundle is intended for architecture analysis in NotebookLM and visual/product review by web-design AI. The app shell is in `index.html` and `src/app/`; reusable behavior is separated into `src/domain/`, `src/session/`, and `src/adapters/`. Device captures, credentials, generated output, and lockfiles are intentionally excluded.\n",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "removeComments": false,
    "removeEmptyLines": false,
    "compress": false,
    "topFilesLength": 12,
    "showLineNumbers": true,
    "truncateBase64": true,
    "copyToClipboard": false,
    "includeFullDirectoryStructure": false,
    "tokenCountTree": true,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 40,
      "includeDiffs": false,
      "includeLogs": true,
      "includeLogsCount": 12
    }
  },
  "include": [
    "README.md",
    "TODO.md",
    "LICENSE",
    "package.json",
    "rescript.json",
    "tsconfig.json",
    "vite.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    "index.html",
    "src/app/**",
    "src/adapters/**",
    "src/session/**",
    "src/domain/**"
  ],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": []
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
